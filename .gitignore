# ---------- Python / Django ----------
.venv/
venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.sqlite3
db.sqlite3
staticfiles/
media/

# Test / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/

# ---------- Secrets ----------
.env
.env.local
.env.*.local

# ---------- Runtime data ----------
# The SQLite database and its WAL/journal sidecars. database/schema.sql is
# tracked; the .db file itself is not.
database/*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm
# Timestamped safety copies taken before migrations, e.g.
# fixrequest.db.bak-before-tracking — also ignored.
database/*.bak
database/*.bak-*
database/*.db.bak*

# Uploaded user documents and profile images. The directories are recreated on
# demand, so nothing needs to be tracked to keep uploads working.
uploads/

# Legacy/alternate data locations
data/

# ---------- Logs ----------
*.log

# Additional DB artifacts
database/*.recovered
database/*.pre-recovery
database/*.db-*
