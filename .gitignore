# ---------- Dependencies ----------
node_modules/

# ---------- Secrets ----------
.env
.env.local
.env.*.local

# ---------- Runtime data ----------
# The SQLite file and its WAL/journal sidecars. schema.sql + seed.js ARE tracked:
# they are the source of truth for a fresh install, the .db is not.
database/*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm
# Timestamped safety copies taken before migrations/seeds, e.g.
# fixrequest.db.bak-before-tracking — also ignored.
database/*.bak
database/*.bak-*
database/*.db.bak*

# Uploaded user documents and profile images. The directories themselves are
# recreated on demand (fs.mkdirSync recursive in routes/auth + routes/technician),
# so nothing needs to be tracked to keep uploads working.
uploads/

# Legacy/alternate data locations
data/

# ---------- Logs ----------
*.log
npm-debug.log*

# Additional DB artifacts
database/*.recovered
database/*.pre-recovery
database/*.db-*
