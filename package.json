{
  "name": "fix-request",
  "version": "1.0.0",
  "description": "Fix Request - a service platform connecting customers with technicians",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "seed": "node database/seed.js",
    "audit": "npm audit --omit=dev",
    "audit:fix": "npm audit fix",
    "format": "prettier --write \"backend/**/*.js\" \"frontend/js/**/*.js\"",
    "format:check": "prettier --check \"backend/**/*.js\" \"frontend/js/**/*.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "file-type": "^16.5.4",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
