# ============================================================
#  Dashawy — environment configuration
# Copy to .env and fill in real values.  .env is git-ignored.
# Load it with Node's built-in flag:   node --env-file=.env backend/server.js
#   (`npm start` does not load it, so export the variables in your shell or
#    use the flag in production.)
# Production REQUIRES JWT_SECRET — the server refuses to boot without it.
# ============================================================

# ---------- Server ----------
NODE_ENV=development
PORT=3000

# ---------- Security (REQUIRED in production) ----------
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-strong-random-32-plus-character-string
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call the API.
# Leave unset locally (localhost is always allowed). Set it in production
# when the frontend is served from a different domain than the API.
#
# Required in production whenever the frontend is NOT served from this same
# origin: with the API and the site on different domains an unset value means
# every browser request is refused, and the tempting "fix" is a wildcard origin.
# The server logs a warning at boot when NODE_ENV=production and this is unset.
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Comma-separated list of trusted proxy hops in front of the app. See the
# Reverse proxy section at the bottom of this file.
# TRUST_PROXY_HOPS=1

# ---------- Google Sign-In (optional, customers only) ----------
# Both variables must be set together; if either is missing the Google button is
# hidden and POST /api/auth/google answers "not enabled". Nothing here is ever
# hard-coded — the server reads these from the environment at boot.
#
# From the Google Cloud console: "APIs & Services" -> "Credentials" -> "Create
# credentials" -> "OAuth client ID" -> type "Web application".
#
#   Authorized JavaScript origins : https://your-domain.com  (and
#                                  http://localhost:3000 while developing)
#   Authorized redirect URIs      : https://your-domain.com/login.html
#
# The client ID is public (the browser needs it); the client secret is a
# credential and must never be committed. The ID-token flow only needs the
# client ID on the server, but both are required so an installation cannot be
# half-configured by accident.
# GOOGLE_CLIENT_ID=000000000000-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# ---------- Database ----------
DATABASE_PATH=./database/fixrequest.db

# ---------- Request broadcast + waiting queue ----------
# Broadcast radius in km. This is the DEPLOYMENT DEFAULT only: once the
# `auto_assign_radius_km` settings row exists (a fresh database seeds it), the
# admin setting wins and this value is ignored — including an explicit 0 there,
# which means "no limit". Only an installation with no settings row uses this.
BROADCAST_RADIUS_KM=10

# How long an offer stays open, in HOURS. When the window passes with no
# acceptance the offers are closed and the request becomes 'no_technician' so an
# admin can pick it up. Anything unparseable or <= 0 falls back to 24.
BROADCAST_TIMEOUT_HOURS=24

# A request created while nobody was available goes on the waiting queue: it is
# re-offered every QUEUE_RECHECK_MINUTES to technicians who have become available
# and are inside the broadcast radius, and cancelled with a reason at
# QUEUE_MAX_HOURS. Any value <= 0 or unparseable falls back to the defaults shown.
QUEUE_RECHECK_MINUTES=5
QUEUE_MAX_HOURS=24

# ---------- Cash confirmation ----------
# How long (hours) a technician's report of a CASH payment waits for the customer
# to confirm the same figure before the sweep settles it on the technician's
# number. The same value is shown to admins as `cash_confirm_timeout_hours`;
# this env var is what the service actually reads. Falls back to 24.
CASH_CONFIRM_TIMEOUT_HOURS=24

# ---------- Web Push (optional) ----------
# Without these three the app runs normally and push is simply off — no push
# subscription is stored and no push endpoint works. Generate ONE key pair per
# installation and keep it stable: changing the public key invalidates every
# existing subscription, and every device then has to re-subscribe by hand.
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The output object has .publicKey and .privateKey. The PRIVATE key is a
# credential — it never belongs in a public repo or in this example file.
# Use mailto: (or https:) in the subject; a bare "someone@example.com" is
# rejected by web-push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---------- Telegram bot (optional but required for Telegram login codes) ----------
# Create a bot with @BotFather, then paste the token it gives you here. The token
# is a credential: never commit it, and set it in the deployment's variable store
# as well. Without it the HTTP server still boots and the bot is simply disabled.
#
# TELEGRAM_BOT_USERNAME is optional. It lets the linking page build a t.me deep
# link before the bot has answered getMe; getMe fills it in automatically when
# omitted, so it is only needed if the bot is temporarily unreachable at boot.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=your_bot_username

# ---------- Uploads ----------
# Per-file ceiling enforced by multer, in megabytes.
#   technician documents : 5 MB
#   profile image       : 3 MB
#   portfolio images    : 5 MB
MAX_UPLOAD_MB=5

# ---------- Reverse proxy ----------
# Number of trusted proxy hops in front of the app. Keep at 1 when behind a
# single nginx/Cloudflare hop so rate limiting sees the real client IP.
TRUST_PROXY_HOPS=1
