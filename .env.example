# ============================================================
#  Dashawy — environment configuration
#  Copy to .env and fill in real values. .env is git-ignored.
#  Django loads this file automatically via python-dotenv.
# ============================================================

# ---------- Django ----------
# Generate a production key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-this-to-a-strong-random-value
# Must be exactly True or False (case-sensitive). Use True only for local dev.
DJANGO_DEBUG=True
# Comma-separated hosts, e.g. yourname.pythonanywhere.com,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- JWT ----------
# Signs and verifies API access tokens. Use a strong, stable 32+ character
# value in production. Falls back to DJANGO_SECRET_KEY when unset.
JWT_SECRET=change-this-to-a-strong-random-32-plus-character-string
# Access/refresh token lifetimes: 30m, 12h, 7d, etc.
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Database ----------
# Django uses database/fixrequest.db. No database variable is required.

# ---------- CORS / CSRF ----------
# Comma-separated exact origins. Wildcards are not supported.
CORS_ALLOWED_ORIGINS=http://localhost:8000
# Required when Django is served from a different HTTPS origin or behind a
# proxy, e.g. https://yourusername.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=

# ---------- Public site configuration ----------
# Single source of truth for the canonical domain and every public contact
# value. Environment values win over the admin-editable settings table.
SITE_URL=https://yourusername.pythonanywhere.com
BUSINESS_PHONE=
BUSINESS_WHATSAPP=
BUSINESS_EMAIL=
PRIVACY_EMAIL=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=

# ---------- Business rules ----------
# Platform commission taken from each completed service price (0-100).
COMMISSION_RATE=20

# ---------- Google Sign-In ----------
# OAuth 2.0 Web client ID from Google Cloud Console. Leave empty to hide the
# "Sign in with Google" button. Add every production origin to the authorized
# JavaScript origins list there.
GOOGLE_CLIENT_ID=
