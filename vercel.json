{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "functions": {
    "dashawy_backend/wsgi.py": {
      "includeFiles": "{core,frontend}/**",
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/settle",
      "schedule": "30 3 * * *"
    }
  ]
}
